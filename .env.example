# ─────────────────────────────────────────────────────────────
# Onda — local Next.js env (copy to `.env.local` and fill in)
# Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# ── Firebase client (required for the main app + RTDB URL for Admin)
# From Firebase Console → Project settings → Your apps → Web app config
#
# FOOTGUN: two GCP projects share the display name "cre8ion Onda".
#   cre8ion-onda          ← use this (owns Realtime Database)
#   cre8ion-onda-503301   ← sibling project; do NOT use for RTDB / Admin SA
# PROJECT_ID, DATABASE_URL, and GOOGLE_APPLICATION_CREDENTIALS must all be
# from cre8ion-onda (no -503301 suffix) or webhook writes will 401.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cre8ion-onda
# Real default bucket for this project (post-2024 Firebase naming):
#   cre8ion-onda.firebasestorage.app
# NOT the legacy cre8ion-onda.appspot.com (that bucket does not exist here).
# Must match Firebase Console → Storage and App Hosting → Environment.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cre8ion-onda.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# From Firebase Console → Realtime Database → Data tab URL
# https://cre8ion-onda-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://cre8ion-onda-default-rtdb.firebaseio.com

# ── Firebase Admin (required for /api/recall/webhook → RTDB writes)
# From Firebase Console (cre8ion-onda) → Project settings → Service accounts →
# Generate new private key. Save the JSON somewhere outside the repo, then
# set this to that absolute path. Key MUST be from cre8ion-onda, not -503301.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional alternative to the file path: paste the entire service-account JSON
# as a single line (useful in some cloud/dev environments).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Recall — Electron per-session forwarder (/api/webhook/[sessionId])
# Shared secret YOU invent — must match electron-spike/.env RECALL_WEBHOOK_SECRET
# (Electron sends it as header x-recall-secret; Next validates it on the
# per-session path ONLY — not on /api/recall/webhook)
RECALL_WEBHOOK_SECRET=

# ── Recall — workspace Svix endpoint (/api/recall/webhook)
# From Recall.ai dashboard → Webhooks → endpoint signing secret (whsec_…).
# Set as a Firebase App Hosting / Secret Manager secret with this exact name
# once the develop/staging custom domain is registered with Recall.
# Official `svix` package verifies svix-id / svix-timestamp / svix-signature.
RECALL_SVIX_SIGNING_SECRET=

# Tech Operator / Electron Step 1 uses:
#   POST /api/tech/unlock | /api/tech/sessions/start|stop|bind-recording
#   POST /api/webhook/[sessionId]   ← per-session transcript + local lifecycle forwarder
#   POST /api/recall/webhook        ← workspace Svix (dashboard) — Svix auth only
# GET /api/health fails loudly unless NEXT_PUBLIC_FIREBASE_PROJECT_ID=cre8ion-onda

# ── Public site origin (QR codes + absolute attendee links)
# Production App Hosting: set BOTH in apphosting.yaml (or console — console wins):
#   NEXT_PUBLIC_APP_URL=https://cre8ion-onda.app   (BUILD + RUNTIME; inlined by Next)
#   ONDA_PUBLIC_APP_URL=https://cre8ion-onda.app   (server runtime; not inlined — QR-safe)
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ONDA_PUBLIC_APP_URL=http://localhost:3000
# QR generation encodes /room/{id} and /session/{id} against this origin.
# Do not hardcode hosts in app code — always read via getPublicAppOrigin().
# WARNING: Pasting .env.local into the App Hosting console with localhost will
# break production QR codes (console overrides apphosting.yaml).

# Optional: only needed if you call Next helpers /api/recall/sdk-upload
# or /api/recall/recordings/* (Electron can also call Recall directly)
# ALSO required by the workspace Svix webhook to Retrieve Recording and upload
# session audio to Firebase Storage on sdk_upload.complete.
# From Recall.ai dashboard → API Keys (use the region that matches your workspace)
RECALL_API_KEY=
# us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=us-west-2
# Optional override for local verification (mock Recall HTTP). Production unset.
# RECALL_API_BASE=http://127.0.0.1:9xxx
# Optional: real recording id for scripts/verify-recall-audio-store-local.ts live mode
# RECALL_TEST_RECORDING_ID=

# ── Cloud Functions only (NOT Next.js) — set in Firebase Functions runtime /
# Google Secret Manager for the cre8ion-onda project. Required by
# onTranscriptChunk + syncDeepLGlossary.
# DEEPL_API_KEY=
