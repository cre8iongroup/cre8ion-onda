# Copy to .env.local and fill from Firebase Console → Project settings → Your apps
# Project: cre8ion-onda

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cre8ion-onda.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cre8ion-onda
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cre8ion-onda.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://cre8ion-onda-default-rtdb.firebaseio.com

# Server-only — never expose to the client
RECALL_WEBHOOK_SECRET=
# Optional local Admin SDK: FIREBASE_SERVICE_ACCOUNT_JSON='{...}'
# Or: GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
