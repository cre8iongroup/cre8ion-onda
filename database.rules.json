{
  "rules": {
    "liveSessions": {
      "$sessionId": {
        // feedState: public read (attendees need to know when feed is live).
        // Authenticated tech/admin may flip feedState for Go Live / standby / end.
        "feedState": {
          ".read": true,
          ".write": "auth != null"
        },
        // Chunks: public read (attendee UI gates on feedState client-side).
        // Writes remain server-only (webhook / Cloud Functions via Admin SDK).
        "chunks": {
          ".read": true,
          ".write": false,
          ".indexOn": ["timestamp"],
          "$chunkId": {
            ".validate": "newData.hasChildren(['text', 'sequenceNumber', 'timestamp', 'isFinalized'])"
          }
        }
      }
    },
    // recordingId → sessionId index for Recall Svix lifecycle webhooks (Admin only)
    "recordingIndex": {
      "$recordingId": {
        ".read": false,
        ".write": false
      }
    }
  }
}
