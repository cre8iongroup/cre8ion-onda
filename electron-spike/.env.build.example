# Onda Operator — BUILD-TIME config (baked into the Windows installer)
# Copy to `.env.build` and fill in on the machine that runs `npm run build:win`.
# Never commit `.env.build` (gitignored via `.env*`).
#
# After install, target machines need NO .env and no manual setup.

# ── Recall API
RECALL_API_KEY=
RECALL_REGION=us-west-2
RECALL_WEBHOOK_SECRET=

# ── Onda production API / webhooks (NOT localhost)
ONDA_API_BASE=https://cre8ion-onda.app
ONDA_WEBHOOK_URL=https://cre8ion-onda.app
# Optional alias used by main for Recall-native realtime webhook base:
# ONDA_PUBLIC_WEBHOOK_BASE=https://cre8ion-onda.app

# Legacy spike field — unused by current session-select flow; safe to leave blank
SESSION_ID=

LANGUAGE_CODE=en
# Optional fallback when show.transcriptionStyle is absent:
# DEEPGRAM_STREAMING_PRESET=baseline

# Must stay false in distributed builds (inject --packaged forces this)
ONDA_LOCAL_FORWARDER_ENABLED=false

# ── Firebase CLIENT config (same NEXT_PUBLIC_* as the Next.js web app)
# CLIENT / public config ONLY — never put Admin SDK / service-account keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cre8ion-onda
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
