# Onda Electron + Recall Desktop SDK — Tech Operator Step 1
# Copy to `.env` and fill in. Never commit `.env`.

# ── Recall API (required to create sdk_upload + retrieve recording)
RECALL_API_KEY=
RECALL_REGION=us-west-2

# ── Onda Next.js API (must be running; Firebase project must be cre8ion-onda)
ONDA_API_BASE=http://localhost:3000

# Must match root `.env.local` RECALL_WEBHOOK_SECRET exactly
RECALL_WEBHOOK_SECRET=

# Synthetic sdk_upload.complete forwarder (posts to /api/webhook/[sessionId]
# with x-recall-secret). DEFAULT OFF — only enable for local/mac verification
# until the real Recall Svix → /api/recall/webhook path is live on the staging
# domain. Production / non-local must leave this unset or false.
# DEFAULT DECISION (flagged for review): gate kept for now; full removal still
# on the table once Svix delivery is confirmed end-to-end.
ONDA_LOCAL_FORWARDER_ENABLED=false

# Optional: public base for Recall-native webhook realtime endpoint
# (per-session path /api/webhook/{sessionId} is appended). Prefer Electron forwarder
# only when ONDA_LOCAL_FORWARDER_ENABLED=true.
# ONDA_PUBLIC_WEBHOOK_BASE=https://your-tunnel.example

# Optional language for recallai_streaming
LANGUAGE_CODE=en

# NOTE: SESSION_ID and ONDA_WEBHOOK_URL are removed — unlock a show with its
# techCredential, pick a session, and the app builds /api/webhook/{sessionId}.
