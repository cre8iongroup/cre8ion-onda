# Onda Electron + Recall Desktop SDK spike (adhoc / in-person)
# Copy to `.env` and fill in. Never commit `.env`.

# ── Recall API (required to create sdk_upload + retrieve recording)
# From Recall.ai dashboard → API Keys
# https://www.recall.ai/ (region console matching RECALL_REGION below)
RECALL_API_KEY=

# Must match the region of the workspace that owns RECALL_API_KEY
# us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=us-west-2

# ── Onda webhook (Next.js local route)
# Leave as-is for local spike (main app must be running on port 3000)
ONDA_WEBHOOK_URL=http://localhost:3000/api/recall/webhook

# Must match root `.env.local` RECALL_WEBHOOK_SECRET exactly
# (you invent this shared string — not from Recall dashboard)
RECALL_WEBHOOK_SECRET=

# RTDB path liveSessions/{SESSION_ID}/chunks — any id is fine for the spike
SESSION_ID=spike-test-session

# Optional: also register a Recall-native webhook realtime endpoint
# (Recall will NOT send x-recall-secret — prefer Electron forwarder)
# ONDA_PUBLIC_WEBHOOK_URL=https://your-tunnel.example/api/recall/webhook

# Optional language for recallai_streaming
LANGUAGE_CODE=en
