rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().baseRole;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    function isAdminOrEditor() {
      return isSignedIn() && getRole() in ['admin', 'editor'];
    }

    function isContributor() {
      return isSignedIn() && getRole() == 'contributor';
    }

    function isAssignedToShow(showId) {
      let userData = getUserData();
      // Admin always has access. Empty assignedShows = all shows for staff roles,
      // but Contributors must be explicitly assigned (never implied all-access).
      return getRole() == 'admin'
        || showId in userData.assignedShows
        || (userData.assignedShows.size() == 0 && getRole() != 'contributor');
    }

    function isTech() {
      return isSignedIn() && getRole() == 'tech';
    }

    function isReviewer() {
      return isSignedIn() && getRole() == 'reviewer';
    }

    // Contributor: read assigned shows for QR download UI; never write.
    function canReadShow(showId) {
      return isSignedIn() && isAssignedToShow(showId) && (
        isAdminOrEditor()
        || isTech()
        || isReviewer()
        || isContributor()
      );
    }

    // ─────────────────────────────────────────────────────
    // Shows
    // ─────────────────────────────────────────────────────

    match /shows/{showId} {
      allow read: if canReadShow(showId);
      allow create: if isAdminOrEditor();
      // Tech-managed fields (credential + Operator settings) may not be changed
      // via client SDK — only Admin SDK after canManageTech check on the API.
      allow update: if isAdminOrEditor()
        && isAssignedToShow(showId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['techCredential', 'operatorInstructions', 'transcriptionStyle', 'deepgramKeyterms']);
      allow delete: if isAdmin();

      // Rooms subcollection (Phase 5) — Contributor read-only for QR UI
      match /rooms/{roomId} {
        allow read: if canReadShow(showId);
        allow create: if isAdminOrEditor() && isAssignedToShow(showId);
        // Admins/editors: full update. Tech: outputConfig only (Output Builder).
        allow update: if isSignedIn() && isAssignedToShow(showId) && (
          isAdminOrEditor()
          || (
            isTech()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outputConfig'])
          )
        );
        allow delete: if isAdminOrEditor() && isAssignedToShow(showId);
      }

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read: if canReadShow(showId);
        allow create: if isAdminOrEditor() && isAssignedToShow(showId);
        // Admins/editors: full update. Tech: feedState only (Go Live control).
        // Contributor: no writes (QR download only).
        allow update: if isSignedIn() && isAssignedToShow(showId) && (
          isAdminOrEditor()
          || (
            isTech()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedState'])
          )
        );
        allow delete: if isAdmin();

        // Transcript chunks — server-only writes
        match /transcripts/{chunkId} {
          allow read: if isSignedIn() && isAssignedToShow(showId) && !isContributor();
          allow write: if false; // Cloud Functions (Admin SDK) only
        }
      }
    }

    // ─────────────────────────────────────────────────────
    // Users
    // ─────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // Output Presets (starting-point templates for room outputConfig)
    // ─────────────────────────────────────────────────────

    match /outputLayouts/{layoutId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && getRole() in ['admin', 'editor', 'tech'];
      allow update: if isSignedIn() && getRole() in ['admin', 'editor', 'tech'];
      allow delete: if isAdminOrEditor();
    }

    // ─────────────────────────────────────────────────────
    // Audit Log — immutable, server-write only
    // ─────────────────────────────────────────────────────

    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions (Admin SDK) only
    }
  }
}
