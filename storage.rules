rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Show logos — readable by anyone (used in attendee + portal views)
    match /shows/{showId}/{fileName} {
      allow read: if fileName.matches('logo\\..+');
      allow write: if request.auth != null
        && fileName.matches('logo\\..+')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Room logos + QR — public read.
    // QR object writes: primary path is Admin SDK (POST /api/admin/qr enforces
    // canEditShows for generate/regenerate). Client auth writes allowed only as
    // a fallback for signed-in staff; Contributors never hit generate.
    match /shows/{showId}/rooms/{roomId}/{fileName} {
      allow read: if fileName.matches('qr\\.(png|svg)') || fileName.matches('logo\\..+');
      allow write: if request.auth != null
        && (
          fileName.matches('qr\\.(png|svg)')
          || fileName.matches('logo\\..+')
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Session QR — same policy as room QR
    match /shows/{showId}/sessions/{sessionId}/{fileName} {
      allow read: if fileName.matches('qr\\.(png|svg)');
      allow write: if request.auth != null
        && fileName.matches('qr\\.(png|svg)')
        && request.resource.size < 2 * 1024 * 1024
        && (
          request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/svg+xml'
        );
    }

    match /exports/{showId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /shows/{showId}/sessions/{sessionId}/audio/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /icons/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /installers/OndaOperatorSetup.exe {
      allow read: if true;
      allow write: if false;
    }

    match /installers/OndaOperatorSetup.dmg {
      allow read: if true;
      allow write: if false;
    }
  }
}
